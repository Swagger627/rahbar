# Build context for indexer/: the image needs requirements.txt and pipeline/ only.
.git
.venv
venv
env
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
.coverage.*
htmlcov
tests
requirements-dev.txt
pyproject.toml
